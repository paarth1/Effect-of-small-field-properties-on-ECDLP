def cf_candidates(num, den, r_max):
    """Continued-fraction convergents of num/den with denominator <= r_max."""
    h_prev, h, k_prev, k = 0, 1, 1, 0
    x = num / den
    out = []
    for _ in range(16):
       ai = math.floor(x)
       h_prev, h = h, ai * h + h_prev
       k_prev, k = k, ai * k + k_prev
       if k > r_max or k == 0: break
       out.append(k)
       frac = x - ai
       if frac == 0: break
       x = 1 / frac
return out
def postprocess(counts, N, a, n_count):
